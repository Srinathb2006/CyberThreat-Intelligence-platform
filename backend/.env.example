# Copy to backend/.env; loaded when starting from the project root or backend directory.
# Use unquoted Java properties values. Environment variables override this file.
DB_URL=jdbc:postgresql://localhost:5432/cyberintel
DB_USERNAME=cyberintel
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIRECTORY=./analysis/uploads
ANALYSIS_DIRECTORY=./analysis
ANALYSIS_TIMEOUT_SECONDS=120
ANALYSIS_RETENTION_DAYS=7
MAX_APK_EXPANDED_BYTES=268435456
MAX_APK_ENTRIES=20000
MAX_ANALYSIS_OUTPUT_BYTES=536870912
MAX_APK_SIZE=50MB
JADX_ENABLED=false
JADX_PATH=
APKTOOL_ENABLED=false
APKTOOL_PATH=
ANDROGUARD_ENABLED=false
# Absolute path to Python with the androguard package installed.
ANDROGUARD_PATH=
YARA_ENABLED=false
YARA_PATH=
YARA_RULES_DIRECTORY=
AAPT_ENABLED=false
AAPT_PATH=
